{
  "name": "qualution-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Qualution: AI-powered interactive quantum computing platform",
  "scripts": {
    "dev": "npm --prefix qualution-frontend run dev",
    "dev:frontend": "npm --prefix qualution-frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --reload --port 8000 --app-dir qualution-backend --reload-dir qualution-backend",
    "install:frontend": "npm --prefix qualution-frontend install",
    "build": "npm --prefix qualution-frontend run build",
    "test": "npm --prefix qualution-frontend run test",
    "test:backend": "python -m pytest qualution-backend\\tests",
    "dev:lesson": "npm --prefix lesson-classical-vs-qubit run dev",
    "build:lesson": "npm --prefix lesson-classical-vs-qubit run build"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
