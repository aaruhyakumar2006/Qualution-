            0.1
          ]
        },
        {
          "id": "txt_s2",
          "text": "2. Orthonormality: \u27e80|0\u27e9 = 1, \u27e81|1\u27e9 = 1, \u27e80|1\u27e9 = 0",
          "role": "body",
          "position": [
            0.0,
