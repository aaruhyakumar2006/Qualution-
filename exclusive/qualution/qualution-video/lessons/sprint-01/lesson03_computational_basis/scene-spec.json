    {
      "id": "scene-08",
      "title": "Summary & Next Steps",
      "durationSeconds": 30,
      "startFrame": 6001,
      "endFrame": 6900,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "We have seen that the computational basis provides the orthonormal coordinates for quantum computation: \u27e8i|j\u27e9 = \u03b4_ij. Next, we discover what happens when a qubit occupies both states simultaneously: Superposition.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Summary: Orthonormal basis {|0\u27e9, |1\u27e9} spans all single-qubit states.",
