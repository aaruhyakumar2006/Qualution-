  "aspectRatio": "16:9",
  "learningObjectives": [
    "Deconstruct complex numbers into polar form: r e^(i\u03b8).",
    "Understand why amplitudes can cancel through destructive interference.",
    "Differentiate global phase e^(i\u03b3) from relative phase e^(i\u03c6).",
    "Prove why global phase is physically unobservable: |e^(i\u03b3)\u03c8|\u00b2 = |\u03c8|\u00b2.",
    "Map single-qubit state space using spherical coordinates (\u03b8, \u03c6)."
  ],
  "curriculumBoundaries": {
    "topicsCovered": [
      "Complex numbers z = a + bi = r e^(i\u03b8)",
      "Absolute value squared |z|\u00b2 = a\u00b2 + b\u00b2",
      "Negative and imaginary amplitudes",
      "Global phase invariance |e^(i\u03b3)\u03b1|\u00b2 = |\u03b1|\u00b2",
      "Relative phase parameterization: |\u03c8\u27e9 = cos(\u03b8/2)|0\u27e9 + e^(i\u03c6)sin(\u03b8/2)|1\u27e9"
    ],
    "topicsDeferred": [
      "Full wave interference demonstrations using Mach-Zehnder (Lesson 7)",
      "Phase kickback in multi-qubit circuits (Sprint 2)"
    ]
  },
  "scenes": [
    {
      "id": "scene-01",
      "title": "The Secret Currency of Quantum Computing",
      "durationSeconds": 20,
      "startFrame": 1,
      "endFrame": 600,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Classical probabilities can only be positive real numbers between zero and one. But quantum mechanics runs on a richer currency: complex numbers that can be positive, negative, or imaginary.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Classical probabilities are strictly non-negative real numbers: p \u2208 [0, 1].",
          "startFrame": 1,
          "endFrame": 300
        },
        {
          "text": "Quantum amplitudes are complex numbers (\u2102) capable of wave cancellation.",
          "startFrame": 301,
          "endFrame": 600
        }
      ],
      "onScreenText": [
        {
          "id": "txt_head",
          "text": "LESSON 6: PROBABILITY AMPLITUDES & PHASES",
          "role": "header",
          "position": [
            -6.0,
            3.8,
            0.1
          ]
        },
        {
          "id": "txt_sub",
          "text": "The Complex Arithmetic Underlying Quantum Advantage",
          "role": "subheader",
          "position": [
            -6.0,
            3.2,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_1_bg",
