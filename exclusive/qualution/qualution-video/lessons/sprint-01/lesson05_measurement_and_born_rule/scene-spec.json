    {
      "id": "scene-05",
      "title": "Irreversibility: The Loss of Phase",
      "durationSeconds": 30,
      "startFrame": 3151,
      "endFrame": 4050,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Notice an essential fact: quantum gates are reversible unitaries, but measurement is strictly irreversible. Once collapsed, all information about the relative phase angle \u03b8 is permanently destroyed.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Quantum gates are reversible unitary operations: U\u2020U = I.",
          "startFrame": 3151,
          "endFrame": 3570
        },
        {
          "text": "Measurement is irreversible projection: relative phase information is lost.",
          "startFrame": 3571,
          "endFrame": 4050
        }
      ],
      "onScreenText": [
        {
          "id": "txt_rev",
          "text": "Quantum Gates = Reversible Unitaries",
          "role": "body",
          "position": [
            -3.5,
            0.5,
            0.1
          ]
        },
        {
          "id": "txt_irrev",
          "text": "Measurement = Irreversible Projection",
          "role": "body",
          "position": [
            3.5,
            0.5,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_5_bg",
          "type": "background_plate",
          "source": "assets/backgrounds/deep_space_grid.png",
          "layer": "background"
        },
        {
          "id": "vis_5_stage",
