    {
      "id": "scene-03",
      "title": "Calculating Probabilities for a Single Qubit",
      "durationSeconds": 30,
      "startFrame": 1351,
      "endFrame": 2250,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "For a single qubit state |\u03c8\u27e9 = \u03b1|0\u27e9 + \u03b2|1\u27e9, the probability of measuring zero is P(0) = |\u03b1|\u00b2, and the probability of measuring one is P(1) = |\u03b2|\u00b2. Because the probabilities must sum to 1, |\u03b1|\u00b2 + |\u03b2|\u00b2 = 1.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Probability of outcome 0: P(0) = |\u03b1|\u00b2.",
          "startFrame": 1351,
          "endFrame": 1770
        },
        {
          "text": "Probability of outcome 1: P(1) = |\u03b2|\u00b2 where |\u03b1|\u00b2 + |\u03b2|\u00b2 = 1.",
          "startFrame": 1771,
          "endFrame": 2250
        }
      ],
      "onScreenText": [
        {
          "id": "txt_p0",
          "text": "P(0) = |\u03b1|\u00b2 = |\u27e80|\u03c8\u27e9|\u00b2",
          "role": "formula",
          "position": [
            -3.5,
            0.8,
            0.1
          ]
        },
        {
          "id": "txt_p1",
          "text": "P(1) = |\u03b2|\u00b2 = |\u27e81|\u03c8\u27e9|\u00b2",
          "role": "formula",
          "position": [
            3.5,
            0.8,
            0.1
          ]
        },
        {
          "id": "txt_total_p",
          "text": "P(0) + P(1) = |\u03b1|\u00b2 + |\u03b2|\u00b2 = 1.0",
          "role": "subheader",
          "position": [
            0.0,
            -1.0,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_3_bg",
          "type": "background_plate",
          "source": "assets/backgrounds/deep_space_grid.png",
          "layer": "background"
        },
        {
          "id": "vis_3_stage",
