    {
      "id": "scene-06",
      "title": "Shots and Empirical Sampling",
      "durationSeconds": 35,
      "startFrame": 4051,
      "endFrame": 5100,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Because a single measurement returns only one bit, quantum computers execute circuits over many repetitions called shots. Running 1,000 shots on an equal superposition yields approximately 500 zeros and 500 ones.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Quantum programs are executed across multiple repeated 'shots'.",
          "startFrame": 4051,
          "endFrame": 4530
        },
        {
          "text": "By accumulating shot histograms, we reconstruct theoretical probability distributions.",
          "startFrame": 4531,
          "endFrame": 5100
        }
      ],
      "onScreenText": [
        {
          "id": "txt_shots",
          "text": "Empirical Sampling via Circuit Shots",
          "role": "header",
          "position": [
            0.0,
            2.5,
            0.1
          ]
        },
        {
          "id": "txt_hist",
          "text": "1,000 Shots on |+\u27e9: ~500 |0\u27e9, ~500 |1\u27e9",
          "role": "subheader",
          "position": [
            0.0,
