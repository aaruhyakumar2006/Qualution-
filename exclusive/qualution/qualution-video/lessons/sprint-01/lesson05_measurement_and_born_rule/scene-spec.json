    {
      "id": "scene-02",
      "title": "Max Born and the Probability Rule",
      "durationSeconds": 25,
      "startFrame": 601,
      "endFrame": 1350,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "In 1926, physicist Max Born discovered how mathematical wavefunctions translate into physical experimental reality. He postulated that the probability of measuring an outcome is the absolute square of its amplitude.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "In 1926, Max Born formulated the quantum probability postulate.",
          "startFrame": 601,
          "endFrame": 960
        },
        {
          "text": "The probability of an outcome equals the absolute square of its amplitude.",
          "startFrame": 961,
          "endFrame": 1350
        }
      ],
      "onScreenText": [
        {
          "id": "txt_born_title",
          "text": "Born's Rule (1926 Nobel Prize Formulation)",
          "role": "header",
          "position": [
            0.0,
            2.5,
            0.1
          ]
        },
        {
          "id": "txt_born_eq",
          "text": "P(x) = |\u27e8x|\u03c8\u27e9|\u00b2",
          "role": "formula",
          "position": [
            0.0,
            0.5,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_2_bg",
          "type": "background_plate",
          "source": "assets/backgrounds/deep_space_grid.png",
          "layer": "background"
        },
        {
