import React, { useMemo, memo, useState, useEffect, useRef } from 'react';
import type { CanonicalCircuitState, CanonicalGate } from '../../features/circuit/circuitEngine';
import type { CircuitRequest } from '../../features/circuit/types';
import { toCanonicalCircuitState } from '../../features/circuit/circuitEngine';
import { IBM_OPERATIONS_PALETTE } from '../../features/circuit/state';
import './CircuitRenderer.css';

const QUBIT_ROW_HEIGHT = 80;
const VISIBLE_BUFFER = 3;

export type CircuitAlignmentMode = 'compact' | 'layers' | 'freeform';

export interface CircuitRendererProps {
  /** Canonical state model or backward-compatible CircuitRequest */
  state?: CanonicalCircuitState;
  circuit?: CircuitRequest;

  /** Selection & highlighting */
  selectedGateIds?: string[];
  highlightedGateId?: string | null;
  highlightedQubitIndex?: number | null;
  inspectedGateId?: string | null;

  /** Interactive event handlers */
  onSelectGate?: (gateId: string | null, multi?: boolean) => void;
  onDeleteGate?: (gateId: string) => void;
  onSlotClick?: (qubit: number, column: number) => void;
  onSlotDrop?: (e: React.DragEvent, qubit: number, column: number) => void;
  onGateHover?: (gateId: string | null) => void;
  onDragOverSlot?: (qubit: number, column: number) => void;
  onDragLeaveSlot?: () => void;

  /** Interactive HUD / Palette state */
  dragOverSlot?: { qubit: number; col: number } | null;
  activePaletteGate?: string | null;

  /** Visual options */
  alignmentMode?: CircuitAlignmentMode;
  totalColumns?: number;
  zoom?: number;
  readOnly?: boolean;
  isInspectMode?: boolean;
  /** Driver mode flag: when true, user input is disabled while scripted driver is in control */
  isLocked?: boolean;
  showColumnTicks?: boolean;
  showClassicalWire?: boolean;
  showStateDisks?: boolean;
  className?: string;
  testId?: string;
}

const MIN_COLUMNS = 16;

/**
 * CircuitRenderer
 *
 * The single, canonical quantum circuit rendering component for QUALUTION.
 * Renders wires, column slots, gate boxes, and multi-qubit entangling connectors.
 * Powers BOTH lesson demonstrations and live Workbench user editing.
 */
export const CircuitRenderer: React.FC<CircuitRendererProps> = ({
  state: controlledState,
  circuit: legacyCircuit,
  selectedGateIds = [],
  highlightedGateId,
  highlightedQubitIndex,
  inspectedGateId,
  onSelectGate,
  onDeleteGate,
  onSlotClick,
  onSlotDrop,
  onGateHover,
  onDragOverSlot,
  onDragLeaveSlot,
  dragOverSlot,
  activePaletteGate,
  alignmentMode = 'compact',
  totalColumns: controlledColumns,
  zoom = 1.0,
  readOnly = false,
  isLocked = false,
  isInspectMode = false,
  showColumnTicks = true,
  showClassicalWire = true,
  showStateDisks = true,
  className = '',
  testId = 'circuit-renderer',
}) => {
  const isInteractiveDisabled = readOnly || isLocked;
  const isSlotDisabled = isInteractiveDisabled || isInspectMode;
  // Normalize input to CanonicalCircuitState
  const state: CanonicalCircuitState = useMemo(() => {
    if (controlledState) return controlledState;
    if (legacyCircuit) return toCanonicalCircuitState(legacyCircuit);
    return {
      qubits: 2,
      classical_bits: 2,
      gates: [],
      measurements: [],
    };
  }, [controlledState, legacyCircuit]);

  // Virtual scrolling state
  const containerRef = useRef<HTMLDivElement>(null);
  const [scrollTop, setScrollTop] = useState(0);
  const [containerHeight, setContainerHeight] = useState(600);

  // For circuits with many qubits, use virtual scrolling
  const totalQubits = Math.max(1, state.qubits);
  const useVirtualization = totalQubits > 15;

  const qubitIndices = useMemo(() => {
    if (!useVirtualization) {
      return Array.from({ length: totalQubits }, (_, i) => i);
    }

    const startIndex = Math.max(0, Math.floor(scrollTop / QUBIT_ROW_HEIGHT) - VISIBLE_BUFFER);
    const visibleCount = Math.ceil(containerHeight / QUBIT_ROW_HEIGHT);
    const endIndex = Math.min(totalQubits, startIndex + visibleCount + VISIBLE_BUFFER * 2);

    return Array.from({ length: endIndex - startIndex }, (_, i) => startIndex + i);
  }, [totalQubits, useVirtualization, scrollTop, containerHeight]);

  // Handle scroll with throttling
  const handleScroll = (e: React.UIEvent<HTMLDivElement>) => {
    setScrollTop(e.currentTarget.scrollTop);
  };

  // Measure container height
  useEffect(() => {
    if (!containerRef.current) return;
    const resizeObserver = new ResizeObserver(entries => {
      for (const entry of entries) {
        setContainerHeight(entry.contentRect.height);
      }
    });
    resizeObserver.observe(containerRef.current);
    return () => resizeObserver.disconnect();
  }, []);

  const maxGateCol = useMemo(
    () => state.gates.reduce((max, g) => Math.max(max, g.column ?? 0), -1),
    [state.gates]
  );

  const numColumns = useMemo(
    () => Math.max(controlledColumns ?? MIN_COLUMNS, maxGateCol + 2),
    [controlledColumns, maxGateCol]
  );

  const columnIndices = useMemo(
    () => Array.from({ length: numColumns }, (_, i) => i),
    [numColumns]
  );

  const activeQubitIndices = useMemo(() => {
    const set = new Set<number>();
    state.gates.forEach((g) => {
      g.targets.forEach((t) => set.add(t));
    });
    return set;
  }, [state.gates]);

  const totalHeight = useVirtualization ? totalQubits * QUBIT_ROW_HEIGHT : undefined;
  const offsetTop = useVirtualization ? Math.floor(scrollTop / QUBIT_ROW_HEIGHT) * QUBIT_ROW_HEIGHT : 0;

  return (
    <div
      ref={containerRef}
      className={`quantum-circuit-grid-wrapper canonical-circuit-renderer ${isLocked ? 'driver-locked' : ''} ${className}`}
      data-testid={testId}
      style={{
        zoom,
        ['--circuit-zoom' as any]: zoom,
        transformOrigin: '0 0',
        overflow: useVirtualization ? 'auto' : undefined,
        maxHeight: useVirtualization ? '70vh' : undefined,
      }}
      onScroll={useVirtualization ? handleScroll : undefined}
    >
      {/* ── 1. Column Header Ticks ── */}
      {showColumnTicks && (
        <div className="column-ticks-header">
          <div className="tick-spacer" />
          <div className="column-ticks-track">
            {columnIndices.map((col) => (
              <div
                key={col}
                className={`col-tick-label ${alignmentMode === 'layers' ? 'layer-tick' : ''}`}
                title={alignmentMode === 'layers' ? `DAG Execution Layer L${col}` : `Column ${col}`}
              >
                {alignmentMode === 'layers' ? `L${col}` : col}
              </div>
            ))}
          </div>
          {showStateDisks && <div className="state-circle-spacer" />}
        </div>
      )}

      {/* ── 2. Quantum Wires & Drop Slots ── */}
      <div
        className="wires-container"
        style={useVirtualization ? {
          height: totalHeight,
          position: 'relative',
        } : undefined}
      >
        <div style={useVirtualization ? {
          transform: `translateY(${offsetTop}px)`,
          willChange: 'transform',
        } : undefined}>
        {qubitIndices.map((qIndex) => {
          const isWireActive = activeQubitIndices.has(qIndex);
          const isQubitHighlighted = highlightedQubitIndex === qIndex;

          return (
            <div
              key={qIndex}
              className={`qubit-wire-row ${isWireActive ? 'wire-active' : ''} ${
                isQubitHighlighted ? 'wire-highlighted' : ''
              }`}
              data-testid={`qubit-wire-${qIndex}`}
              data-teaching-target={`circuit-q${qIndex}`}
            >
              {/* Left Fixed Qubit Label Box */}
              <div className="qubit-label-box">
                <span className="qubit-name">q[{qIndex}]</span>
              </div>

              {/* Wire Line & Column Slots */}
              <div className="quantum-wire-track">
                <div className={`wire-line ${isWireActive ? 'wire-line-active' : ''}`} />

                {columnIndices.map((colIndex) => {
                  const placedGate = state.gates.find(
                    (g) => (g.column ?? 0) === colIndex && g.targets.includes(qIndex)
                  );

                  const isDragOver =
                    dragOverSlot?.qubit === qIndex && dragOverSlot?.col === colIndex;

                  const isSelected = Boolean(
                    placedGate && placedGate.id && selectedGateIds.includes(placedGate.id)
                  );
                  const isHighlighted = Boolean(
                    placedGate &&
                      (placedGate.id === highlightedGateId ||
                        (placedGate.id && selectedGateIds.includes(placedGate.id)))
                  );
                  const isInspected = Boolean(
                    placedGate && inspectedGateId && placedGate.id === inspectedGateId
                  );

                  return (
                    <div
                      key={colIndex}
                      className={`gate-grid-slot ${isDragOver ? 'drag-over' : ''} ${
                        !isSlotDisabled && activePaletteGate && !placedGate ? 'tap-place-target' : ''
                      }`}
                      tabIndex={isSlotDisabled ? -1 : placedGate ? -1 : 0}
                      role={isSlotDisabled ? undefined : placedGate ? undefined : 'button'}
                      aria-label={
                        placedGate
                          ? undefined
                          : `Qubit ${qIndex}, Column ${colIndex} - Empty slot. ${activePaletteGate ? `Tap to place ${activePaletteGate.toUpperCase()}` : 'Press Enter to place Hadamard gate.'}`
                      }
                      onClick={(e) => {
                        if (isSlotDisabled) return;
                        if (!placedGate) {
                          onSlotClick?.(qIndex, colIndex);
                        }
                      }}
                      onKeyDown={(e) => {
                        if (isSlotDisabled) return;
                        if (!placedGate && (e.key === 'Enter' || e.key === ' ')) {
                          e.preventDefault();
                          onSlotClick?.(qIndex, colIndex);
                        }
                      }}
                      onDragOver={(e) => {
                        if (isSlotDisabled) return;
                        e.preventDefault();
                        onDragOverSlot?.(qIndex, colIndex);
                      }}
                      onDragLeave={() => {
                        if (isSlotDisabled) return;
                        onDragLeaveSlot?.();
                      }}
                      onDrop={(e) => {
                        if (isSlotDisabled) return;
                        onSlotDrop?.(e, qIndex, colIndex);
                      }}
                      data-testid={`slot-${qIndex}-${colIndex}`}
                      data-teaching-target={`circuit-q${qIndex}-col${colIndex}`}
                    >
                      {placedGate && (
                        <CanonicalGateItem
                          gate={placedGate}
                          qubitIndex={qIndex}
                          isSelected={isSelected}
                          isHighlighted={isHighlighted}
                          isInspected={isInspected}
                          readOnly={isInteractiveDisabled}
                          isInspectMode={isInspectMode}
                          onSelect={(multi) => onSelectGate?.(placedGate.id, multi)}
                          onDelete={() => onDeleteGate?.(placedGate.id)}
                          onHover={(hover) => onGateHover?.(hover ? placedGate.id : null)}
                        />
                      )}
                    </div>
                  );
                })}
              </div>

              {/* Right Wire State Disk */}
              {showStateDisks && (
                <div className="wire-state-disk-box" title={`State disk on q[${qIndex}]`}>
                  <div className="wire-state-disk">
                    <div className="disk-split-circle" />
                  </div>
                </div>
              )}
            </div>
          );
        })}

        {/* ── 3. Classical Register Wire ── */}
        {showClassicalWire && (
          <div className="classical-wire-row">
            <div className="qubit-label-box classical-lbl">
              <span className="qubit-name">c{state.classical_bits || state.qubits}</span>
            </div>
            <div className="quantum-wire-track classical-track">
              <div className="classical-double-line top" />
              <div className="classical-double-line bottom" />
            </div>
            {showStateDisks && <div className="wire-state-disk-box" />}
          </div>
        )}
      </div>
    </div>
  );
};

// ── 4. Canonical Gate Item Renderer ────────────────────────────────────

interface CanonicalGateItemProps {
  gate: CanonicalGate;
  qubitIndex: number;
  isSelected: boolean;
  isHighlighted?: boolean;
  isInspected?: boolean;
  readOnly?: boolean;
  isInspectMode?: boolean;
  onSelect?: (multi?: boolean) => void;
  onDelete?: () => void;
  onHover?: (isHovered: boolean) => void;
}

const CanonicalGateItem: React.FC<CanonicalGateItemProps> = ({
  gate,
  qubitIndex,
  isSelected,
  isHighlighted,
  isInspected,
  readOnly = false,
  isInspectMode = false,
  onSelect,
  onDelete,
  onHover,
}) => {
  const gateType = (gate.type || gate.gate || 'h').toLowerCase();
  const paletteItem = IBM_OPERATIONS_PALETTE.find((item) => item.id.toLowerCase() === gateType);

  const isCustom = gateType === 'custom';
  const gateTargets = Array.isArray(gate.targets) && gate.targets.length > 0 ? gate.targets : [qubitIndex];
  const minTarget = Math.min(...gateTargets);
  const maxTarget = Math.max(...gateTargets);
  const isCustomRoot = isCustom && qubitIndex === minTarget;
  const isCustomChild = isCustom && qubitIndex !== minTarget;

  const isMultiQubit = !isCustom && gateTargets.length > 1;
  const controlledGates = ['cx', 'ccx', 'mcx', 'cp', 'crx', 'cry', 'crz', 'cz'];
  const isControlledGate = controlledGates.includes(gateType);

  const isStandaloneControl = gateType === 'control';
  const isControl = (isMultiQubit && isControlledGate && gateTargets.slice(0, -1).includes(qubitIndex)) || isStandaloneControl;
  const isTarget = isMultiQubit && isControlledGate && gateTargets[gateTargets.length - 1] === qubitIndex;

  const isCZ = !isCustom && gateType === 'cz';
  const isCP = !isCustom && gateType === 'cp';
  const isSWAP = !isCustom && gateType === 'swap';

  const isMeasure = gateType === 'measure';
  const isReset = gateType === 'reset' || gateType === '|0>' || gateType === '|0⟩' || gateType === 'dirac 0' || gateType === 'dirac0';
  const isBarrier = gateType === 'barrier';

  const tooltipText = isCustom
    ? `${gate.name || 'Custom Gate'}\nTargets: q[${gate.targets.join(', ')}]`
    : isMeasure
    ? `Measurement (Z-basis) on q[${qubitIndex}]`
    : isReset
    ? `Reset State |0⟩ on q[${qubitIndex}]`
    : isBarrier
    ? `Barrier on q[${qubitIndex}]`
    : isStandaloneControl
    ? `Control Node on q[${qubitIndex}]`
    : isMultiQubit && isControlledGate
    ? `${gateType.toUpperCase()}\nControls: q[${gate.targets.slice(0, -1).join(', ')}]\nTarget: q[${gate.targets[gate.targets.length - 1]}]`
    : gate.angle !== undefined
    ? `${gateType.toUpperCase()}(${(gate.angle / Math.PI).toFixed(2)}π) on q[${qubitIndex}]`
    : `${gateType.toUpperCase()} on q[${qubitIndex}]`;

  if (isCustomChild) {
    return (
      <div
        data-testid={`custom-placeholder-${qubitIndex}`}
        style={{ width: '100%', height: '100%', pointerEvents: 'none' }}
      />
    );
  }

  const handleDragStart = (e: React.DragEvent) => {
    if (readOnly || isInspectMode) return;
    e.stopPropagation();
    if (gate.id) {
      e.dataTransfer.setData('application/qualution-move-gate', gate.id);
      e.dataTransfer.effectAllowed = 'move';
    }
  };

  const gateStyle: React.CSSProperties = {
    ...(isCustomRoot ? { height: `${(maxTarget - minTarget) * 58 + 42}px`, zIndex: 10 } : {}),
    ...(isControl ? { backgroundColor: 'transparent', borderColor: 'transparent' } : {}),
    ...(isBarrier ? { backgroundColor: 'rgba(141, 141, 141, 0.18)', borderColor: '#8d8d8d' } : {}),
    ...((isMeasure || isReset)
      ? {
          backgroundColor: '#525252',
          borderColor: isSelected ? '#ffffff' : '#a8a8a8',
          color: '#ffffff',
        }
      : paletteItem && !isControl && !isBarrier
      ? {
          backgroundColor: paletteItem.color,
          borderColor: isSelected ? '#ffffff' : paletteItem.color === '#a6c8ff' ? '#78a9ff' : undefined,
          color: paletteItem.textColor || '#ffffff',
        }
      : {}),
  };

  return (
    <div
      className={`circuit-placed-gate ${isControl || isCZ || isCP || isSWAP ? 'control-node' : ''} ${
        isTarget && !isCZ && !isCP && !isSWAP ? 'target-node' : ''
      } ${isCustomRoot ? 'custom-gate-block' : ''} ${isBarrier ? 'barrier-node' : ''} ${
        isMeasure ? 'measure-node' : ''
      } ${isReset ? 'reset-node' : ''} ${isSelected ? 'selected' : ''} ${
        isHighlighted ? 'timeline-highlight' : ''
      } ${isInspected ? 'inspected-gate-active' : ''}`}
      style={gateStyle}
      tabIndex={readOnly ? -1 : 0}
      role={readOnly ? undefined : 'button'}
      aria-label={tooltipText.replace(/\n/g, ', ')}
      onClick={(e) => {
        if (readOnly) return;
        e.stopPropagation();
        onSelect?.(e.shiftKey || e.ctrlKey || e.metaKey);
      }}
      onKeyDown={(e) => {
        if (readOnly) return;
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          e.stopPropagation();
          onSelect?.(e.shiftKey || e.ctrlKey || e.metaKey);
        } else if (e.key === 'Delete' || e.key === 'Backspace') {
          e.preventDefault();
          e.stopPropagation();
          if (isInspectMode) return;
          onDelete?.();
        }
      }}
      onMouseEnter={() => onHover?.(true)}
      onMouseLeave={() => onHover?.(false)}
      draggable={!readOnly && !isInspectMode}
      onDragStart={handleDragStart}
      data-testid={`placed-gate-${gateType}-${gate.column}`}
      title={tooltipText}
    >
      {/* ── Multi-Qubit Connector Line (drawn from the uppermost target with stroke-dashoffset animation) ── */}
      {isMultiQubit && qubitIndex === minTarget && (
        <div
          className="two-qubit-connector-line"
          data-testid="two-qubit-connector-line"
          style={{
            position: 'absolute',
            width: 4,
            left: '50%',
            transform: 'translateX(-50%)',
            top: '50%',
            height: `${(maxTarget - minTarget) * 58}px`,
            zIndex: -1,
            pointerEvents: 'none',
          }}
        >
          <svg
            width="4"
            height={`${(maxTarget - minTarget) * 58}`}
            style={{ overflow: 'visible', display: 'block' }}
          >
            <line
              x1="2"
              y1="0"
              x2="2"
              y2={`${(maxTarget - minTarget) * 58}`}
              stroke={isSelected ? '#ffffff' : '#4589ff'}
              strokeWidth="2"
              strokeDasharray={`${(maxTarget - minTarget) * 58}`}
              className="animated-connector-svg-line"
              style={{
                strokeDasharray: `${(maxTarget - minTarget) * 58}`,
                strokeDashoffset: 0,
              }}
            />
          </svg>
        </div>
      )}

      {/* ── Node Visuals ── */}
      {isControl || (isTarget && (isCZ || isCP)) ? (
        <div className="cx-control-dot" />
      ) : isTarget && ['cx', 'ccx', 'mcx'].includes(gateType) ? (
        <div className="cx-target-cross">⊕</div>
      ) : isSWAP ? (
        <div className="swap-cross">✕</div>
      ) : isMeasure ? (
        <div className="gate-label-content measure-gate-content">
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            strokeWidth="1.8"
            className="ibm-svg-symbol measure-symbol"
            aria-hidden="true"
          >
            <path d="M4 17 A8.5 8.5 0 0 1 20 17" />
            <line x1="12" y1="17" x2="16.5" y2="8" />
            <circle cx="12" cy="17" r="1.8" fill="currentColor" stroke="none" />
            <text x="17.5" y="8" fontSize="7.5" fill="currentColor" stroke="none" fontFamily="monospace" fontWeight="bold">z</text>
          </svg>
        </div>
      ) : isReset ? (
        <div className="gate-label-content dirac-reset-content">
          <span className="gate-symbol dirac-symbol" style={{ fontSize: '15px', fontWeight: 700, fontFamily: 'var(--font-mono, monospace)' }}>
            |0⟩
          </span>
        </div>
      ) : isBarrier ? (
        <div className="barrier-visual" style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', height: '100%', width: '100%' }}>
          <svg viewBox="0 0 16 36" width="16" height="36" fill="none" stroke="currentColor" strokeWidth="2" strokeDasharray="3 3">
            <line x1="8" y1="2" x2="8" y2="34" />
          </svg>
        </div>
      ) : isCustomRoot ? (
        <div className="gate-label-content custom-gate-content">
          <span className="gate-symbol" style={{ fontSize: '12px' }}>
            {gate.name || 'CUSTOM'}
          </span>
        </div>
      ) : (
        <div className="gate-label-content">
          <span className="gate-symbol">
            {isTarget && ['crx', 'cry', 'crz'].includes(gateType)
              ? gateType.substring(1).toUpperCase()
              : gateType.toUpperCase()}
          </span>
          {gate.angle !== undefined && (
            <span className="gate-angle-subscript">{(gate.angle / Math.PI).toFixed(2)}π</span>
          )}
        </div>
      )}

      {/* Quick Delete button when selected */}
      {!readOnly && !isInspectMode && isSelected && onDelete && (
        <button
          type="button"
          className="gate-delete-quick-btn"
          onClick={(e) => {
            e.stopPropagation();
            onDelete();
          }}
          title="Delete Gate"
          data-testid="gate-quick-delete"
        >
          ✕
        </button>
      )}
    </div>
  );
};
