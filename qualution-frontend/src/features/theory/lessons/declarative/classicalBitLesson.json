{
  "version": 1,
  "id": "classical-bit-lesson",
  "title": "What is a Classical Bit?",
  "description": "Comprehensive foundation on classical binary states, voltage levels, and determinism.",
  "concepts": ["classical-bit", "determinism"],
  "misconceptions": ["superposition-not-mixture"],
  "defaults": {
    "duration": 1.5,
    "color": "#F8FAFC"
  },
  "actions": [
    {
      "type": "WRITE",
      "id": "title",
      "text": "WHAT IS A CLASSICAL BIT?",
