# ==============================================================================
# QUALUTION Frontend Environment Configuration Template
# Frontend uses only public anonymous keys and public endpoints.
# Never expose backend service-role keys or AI provider secrets here.
# ==============================================================================

# Backend REST API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Supabase Client Configuration (Public Anon Key ONLY)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key-here

# Portal Telemetry Feature Flags & Performance Controls
# Enable or disable the 3D scroll book view (falls back to 2D list view when false)
VITE_ENABLE_3D_BOOK=true
# Number of latest signals cached offline in Dexie.js IndexedDB
VITE_DEXIE_CACHE_SIZE=50

# Optional: ElevenLabs API Key for Erwin neural voice synthesis
VITE_ELEVENLABS_API_KEY=
