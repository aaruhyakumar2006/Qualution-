{
  "name": "qualution-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build --target web src/wasm/qualution-core",
    "build": "npm run build:wasm && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "types:supabase": "supabase gen types typescript --workdir ../supabase --local > src/features/portal/types/database.types.ts",
    "types:supabase:linked": "supabase gen types typescript --workdir ../supabase --linked > src/features/portal/types/database.types.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/three": "^0.186.0",
    "animejs": "^4.5.0",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.6",
    "katex": "^0.18.7",
    "lucide-react": "^1.16.0",
    "ogl": "^1.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.7",
    "wasm-pack": "^0.15.0",
    "workbox-window": "^7.4.1"
  }
}
