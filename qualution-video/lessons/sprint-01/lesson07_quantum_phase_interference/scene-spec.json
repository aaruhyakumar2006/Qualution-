    {
      "id": "scene-05",
      "title": "The H-Z-H Interference Experiment",
      "durationSeconds": 35,
      "startFrame": 3151,
      "endFrame": 4200,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Now let us observe the full power of interference. Start in |0\u27e9. Apply H to create |+\u27e9. Apply Z to flip the phase to |-\u27e9. Now apply H a second time! The paths to |0\u27e9 destructively cancel, and we measure |1\u27e9 with 100% certainty!",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Start at |0\u27e9 -> H -> |+\u27e9 -> Z -> |-\u27e9 -> H -> |1\u27e9.",
          "startFrame": 3151,
          "endFrame": 3630
        },
        {
          "text": "The paths to |0\u27e9 cancel to 0; the paths to |1\u27e9 reinforce to 100% certainty!",
          "startFrame": 3631,
          "endFrame": 4200
        }
      ],
      "onScreenText": [
        {
          "id": "txt_hzh",
          "text": "H \u00b7 Z \u00b7 H = X (Bit-Flip via Phase Interference)",
          "role": "formula",
          "position": [
            0.0,
            1.0,
            0.1
          ]
        },
        {
          "id": "txt_tree",
          "text": "Paths to |0\u27e9: (+1/2) + (-1/2) = 0 | Paths to |1\u27e9: (+1/2) + (+1/2) = 1",
          "role": "subheader",
          "position": [
            0.0,
            -0.8,
            0.1
          ]
        }
      ],
      "visualElements": [
