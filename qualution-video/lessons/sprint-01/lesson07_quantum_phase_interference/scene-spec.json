    {
      "id": "scene-03",
      "title": "The Pauli-Z Phase Gate",
      "durationSeconds": 30,
      "startFrame": 1351,
      "endFrame": 2250,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "To control phase in a quantum circuit, we use phase gates. The foundational phase gate is Pauli-Z. Acting on |0\u27e9, Z leaves it unchanged. But acting on |1\u27e9, it flips the sign, imparting a 180-degree relative phase shift.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "The Pauli-Z gate imparts a 180\u00b0 (\u03c0) relative phase shift to |1\u27e9.",
          "startFrame": 1351,
          "endFrame": 1770
        },
        {
          "text": "Z|0\u27e9 = |0\u27e9, while Z|1\u27e9 = -|1\u27e9. Z leaves computational probabilities unchanged!",
          "startFrame": 1771,
          "endFrame": 2250
        }
      ],
      "onScreenText": [
        {
          "id": "txt_z_mat",
          "text": "Z = [ [1,  0], [0, -1] ]",
          "role": "formula",
          "position": [
            0.0,
            1.2,
            0.1
          ]
        },
        {
          "id": "txt_z_act",
          "text": "Z |0\u27e9 = |0\u27e9  |  Z |1\u27e9 = -|1\u27e9",
          "role": "formula",
          "position": [
            0.0,
            -0.6,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_3_bg",
          "type": "background_plate",
