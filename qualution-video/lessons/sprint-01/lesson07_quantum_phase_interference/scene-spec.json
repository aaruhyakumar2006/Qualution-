    {
      "id": "scene-02",
      "title": "Constructive vs Destructive Interference",
      "durationSeconds": 25,
      "startFrame": 601,
      "endFrame": 1350,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "When two quantum paths are in phase (peaks aligned with peaks), their amplitudes add constructively, amplifying probability. When they are 180 degrees out of phase, peaks meet troughs and cancel out completely.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Constructive: in-phase waves add together, amplifying probability.",
          "startFrame": 601,
          "endFrame": 960
        },
        {
          "text": "Destructive: opposite-phase waves cancel out, driving probability to zero.",
          "startFrame": 961,
          "endFrame": 1350
        }
      ],
      "onScreenText": [
        {
          "id": "txt_interf",
          "text": "Principles of Quantum Wave Interference",
          "role": "header",
          "position": [
            0.0,
            2.5,
            0.1
          ]
        },
        {
          "id": "txt_const",
          "text": "Constructive: (+A) + (+A) = +2A (P \u221d 4A\u00b2)",
          "role": "body",
          "position": [
            -4.0,
            0.0,
            0.1
          ]
        },
        {
          "id": "txt_dest",
          "text": "Destructive: (+A) + (-A) = 0 (P = 0)",
          "role": "body",
          "position": [
            4.0,
            0.0,
            0.1
          ]
        }
      ],
