    {
      "id": "scene-04",
      "title": "Transforming |+\u27e9 to |-\u27e9",
      "durationSeconds": 30,
      "startFrame": 2251,
      "endFrame": 3150,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Consider what happens when Z acts on the plus state |+\u27e9 = (|0\u27e9 + |1\u27e9)/\u221a2. The |0\u27e9 term remains positive, while the |1\u27e9 term flips negative, transforming |+\u27e9 directly into the minus state |-\u27e9!",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Z |+\u27e9 = Z [ (|0\u27e9 + |1\u27e9)/\u221a2 ] = (|0\u27e9 - |1\u27e9)/\u221a2 = |-\u27e9.",
          "startFrame": 2251,
          "endFrame": 2700
        },
        {
          "text": "Z rotates the state vector across the equator of the Bloch sphere.",
          "startFrame": 2701,
          "endFrame": 3150
        }
      ],
      "onScreenText": [
        {
          "id": "txt_z_plus",
          "text": "Z |+\u27e9 = |-\u27e9",
          "role": "formula",
          "position": [
            0.0,
            0.8,
            0.1
          ]
        },
        {
          "id": "txt_z_minus",
          "text": "Z |-\u27e9 = |+\u27e9",
          "role": "formula",
          "position": [
            0.0,
            -0.6,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_4_bg",
          "type": "background_plate",
