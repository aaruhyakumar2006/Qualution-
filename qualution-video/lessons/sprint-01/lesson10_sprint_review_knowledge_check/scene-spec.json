    {
      "id": "scene-02",
      "title": "Pillar 1: The Quantum State Vector",
      "durationSeconds": 30,
      "startFrame": 601,
      "endFrame": 1500,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Remember Pillar 1: A qubit is a unit vector |\u03c8\u27e9 = \u03b1|0\u27e9 + \u03b2|1\u27e9 in two-dimensional complex Hilbert space. The normalization constraint |\u03b1|\u00b2 + |\u03b2|\u00b2 = 1 guarantees that total probability is always 100 percent.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Pillar 1: |\u03c8\u27e9 = \u03b1|0\u27e9 + \u03b2|1\u27e9 in \u2102\u00b2 Hilbert space.",
          "startFrame": 601,
          "endFrame": 1020
        },
        {
          "text": "Conservation of probability: |\u03b1|\u00b2 + |\u03b2|\u00b2 = 1.0 always.",
          "startFrame": 1021,
          "endFrame": 1500
        }
      ],
      "onScreenText": [
        {
          "id": "txt_p1_title",
          "text": "Pillar 1: The Quantum State Vector",
          "role": "header",
          "position": [
            0.0,
            2.0,
            0.1
          ]
        },
        {
          "id": "txt_p1_eq",
          "text": "|\u03c8\u27e9 = \u03b1|0\u27e9 + \u03b2|1\u27e9  with  |\u03b1|\u00b2 + |\u03b2|\u00b2 = 1",
          "role": "formula",
          "position": [
            0.0,
            0.0,
            0.1
          ]
        }
      ],
