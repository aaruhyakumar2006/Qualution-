    {
      "id": "scene-04",
      "title": "Pillar 3: The Single-Qubit Gate Suite",
      "durationSeconds": 35,
      "startFrame": 2401,
      "endFrame": 3450,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Pillar 3: All single-qubit gates are unitary rotations. X flips bits; Z flips relative phase; H creates superposition; S and T apply \u03c0/2 and \u03c0/4 phase shifts; and Rx, Ry, Rz provide continuous angle control.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Pillar 3: Quantum gates are unitary rotations (U\u2020U = I).",
          "startFrame": 2401,
          "endFrame": 2880
        },
        {
          "text": "X = Bit-flip | Z = Phase-flip | H = Superposition | S, T = Phase shifts.",
          "startFrame": 2881,
          "endFrame": 3450
        }
      ],
      "onScreenText": [
        {
          "id": "txt_p3_title",
          "text": "Pillar 3: Canonical Single-Qubit Gates",
          "role": "header",
          "position": [
            0.0,
            2.5,
            0.1
          ]
        },
        {
          "id": "txt_p3_grid",
          "text": "X, Y, Z (Pauli) | H (Hadamard) | S, T (Phase) | R_x, R_y, R_z (Rotations)",
          "role": "body",
          "position": [
            0.0,
            0.5,
            0.1
          ]
        }
