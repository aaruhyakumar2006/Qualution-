    {
      "id": "scene-05",
      "title": "Pillar 4: Quantum Phase & Interference",
      "durationSeconds": 35,
      "startFrame": 3451,
      "endFrame": 4500,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Pillar 4: Relative phase drives wave interference. By chaining gates like Hadamard and Z, quantum algorithms engineer destructive cancellation for incorrect paths and constructive amplification for the solution.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Pillar 4: Relative phase steers constructive and destructive interference.",
          "startFrame": 3451,
          "endFrame": 3930
        },
        {
          "text": "H \u00b7 Z \u00b7 H = X: Interference transforms a phase flip into a bit flip.",
          "startFrame": 3931,
          "endFrame": 4500
        }
      ],
      "onScreenText": [
        {
          "id": "txt_p4_title",
          "text": "Pillar 4: Wave Interference in Action",
          "role": "header",
          "position": [
            0.0,
            2.0,
            0.1
          ]
        },
        {
          "id": "txt_p4_interf",
          "text": "H \u00b7 Z \u00b7 H = X (Interference Identity)",
