    {
      "id": "scene-03",
      "title": "Pillar 2: Born's Rule & Measurement",
      "durationSeconds": 30,
      "startFrame": 1501,
      "endFrame": 2400,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Pillar 2: Measurement is non-deterministic and irreversible. Born's Rule tells us that the probability of observing outcome x is the absolute square of its inner product with the state: P(x) = |\u27e8x|\u03c8\u27e9|\u00b2.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Pillar 2: Measurement collapses superposition irreversibly.",
          "startFrame": 1501,
          "endFrame": 1920
        },
        {
          "text": "Born's Rule: P(x) = |\u27e8x|\u03c8\u27e9|\u00b2. P(0) = |\u03b1|\u00b2, P(1) = |\u03b2|\u00b2.",
          "startFrame": 1921,
          "endFrame": 2400
        }
      ],
      "onScreenText": [
        {
          "id": "txt_p2_title",
          "text": "Pillar 2: Born's Rule & Collapse",
          "role": "header",
          "position": [
            0.0,
            2.0,
            0.1
          ]
        },
        {
          "id": "txt_p2_eq",
          "text": "P(x) = |\u27e8x|\u03c8\u27e9|\u00b2  (Irreversible Projection)",
          "role": "formula",
          "position": [
            0.0,
            0.0,
            0.1
          ]
        }
      ],
