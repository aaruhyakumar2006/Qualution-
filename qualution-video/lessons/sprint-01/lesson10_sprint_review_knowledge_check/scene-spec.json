    {
      "id": "scene-06",
      "title": "Diagnostic Practice Question",
      "durationSeconds": 40,
      "startFrame": 4501,
      "endFrame": 5700,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Let us test your intuition: Starting in state |0\u27e9, what state results from applying an X gate followed by an H gate? First, X flips |0\u27e9 to |1\u27e9. Then H transforms |1\u27e9 into the minus state: (|0\u27e9 - |1\u27e9) / \u221a2!",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Diagnostic Challenge: What is the state after applying X then H to |0\u27e9?",
          "startFrame": 4501,
          "endFrame": 5040
        },
        {
          "text": "Step 1: X|0\u27e9 = |1\u27e9. Step 2: H|1\u27e9 = |-\u27e9 = (|0\u27e9 - |1\u27e9)/\u221a2. Excellent!",
          "startFrame": 5041,
          "endFrame": 5700
        }
      ],
      "onScreenText": [
        {
          "id": "txt_diag_q",
          "text": "Challenge: H \u00b7 X |0\u27e9 = ?",
          "role": "header",
          "position": [
            0.0,
            2.0,
            0.1
          ]
        },
        {
          "id": "txt_ans",
          "text": "Answer: |-\u27e9 = (|0\u27e9 - |1\u27e9) / \u221a2",
          "role": "formula",
          "position": [
            0.0,
            0.0,
            0.1
          ]
        }
      ],
