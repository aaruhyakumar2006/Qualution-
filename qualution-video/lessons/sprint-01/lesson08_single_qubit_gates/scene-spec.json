    {
      "id": "scene-02",
      "title": "The Unitarity Requirement",
      "durationSeconds": 25,
      "startFrame": 601,
      "endFrame": 1350,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Every valid quantum gate must be represented by a unitary matrix U. Unitarity means that U dagger times U equals the identity matrix. This guarantees that total probability is strictly conserved and operations are reversible.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Every quantum gate is a unitary matrix U satisfying U\u2020U = I.",
          "startFrame": 601,
          "endFrame": 960
        },
        {
          "text": "Unitarity preserves vector length (||U|\u03c8\u27e9|| = 1) and ensures reversibility.",
          "startFrame": 961,
          "endFrame": 1350
        }
      ],
      "onScreenText": [
        {
          "id": "txt_unit_title",
          "text": "The Unitarity Condition",
          "role": "header",
          "position": [
            0.0,
            2.0,
            0.1
          ]
        },
        {
          "id": "txt_unit_eq",
          "text": "U\u2020 \u00b7 U = I  (U\u2020 = (U*)\u1d40)",
          "role": "formula",
          "position": [
            0.0,
            0.2,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_2_bg",
          "type": "background_plate",
          "source": "assets/backgrounds/deep_space_grid.png",
          "layer": "background"
        },
        {
          "id": "vis_2_stage",
