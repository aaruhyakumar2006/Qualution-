    {
      "id": "scene-03",
      "title": "The Pauli Gates: X, Y, and Z",
      "durationSeconds": 35,
      "startFrame": 1351,
      "endFrame": 2400,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "The fundamental single-qubit operators are the Pauli matrices. Pauli-X is the quantum NOT gate, rotating 180 degrees around the X-axis. Pauli-Z flips phase by 180 degrees around the Z-axis. And Pauli-Y flips both bit and phase.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Pauli-X flips bit values: X|0\u27e9 = |1\u27e9, X|1\u27e9 = |0\u27e9 (180\u00b0 rotation about X).",
          "startFrame": 1351,
          "endFrame": 1830
        },
        {
          "text": "Pauli-Z flips phase: Z|1\u27e9 = -|1\u27e9. Pauli-Y combines bit flip and phase shift.",
          "startFrame": 1831,
          "endFrame": 2400
        }
      ],
      "onScreenText": [
        {
          "id": "txt_paulix",
          "text": "X = [ [0, 1], [1, 0] ]",
          "role": "formula",
          "position": [
            -4.5,
            0.5,
            0.1
          ]
        },
        {
          "id": "txt_pauliy",
          "text": "Y = [ [0, -i], [i, 0] ]",
          "role": "formula",
          "position": [
            0.0,
            0.5,
            0.1
          ]
        },
        {
          "id": "txt_pauliz",
          "text": "Z = [ [1, 0], [0, -1] ]",
          "role": "formula",
          "position": [
            4.5,
            0.5,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_3_bg",
          "type": "background_plate",
          "source": "assets/backgrounds/deep_space_grid.png",
          "layer": "background"
        },
        {
          "id": "vis_3_stage",
          "type": "vector_diagram",
          "source": "procedural_blender_object",
          "layer": "primary"
        }
      ],
      "animationActions": [
        {
          "target": "vis_3_stage",
          "action": "fade_in_and_settle",
          "startFrame": 1351,
          "durationFrames": 30
        }
      ],
      "assetsRequired": [
        "deep_space_grid.png",
        "ibm_quantum_palette.blend"
      ],
      "educationalPurpose": "Introduce the three Pauli matrices and their algebraic actions.",
      "transitionOut": "smooth_crossfade"
