        }
      ],
      "assetsRequired": [
        "deep_space_grid.png",
        "ibm_quantum_palette.blend"
      ],
      "educationalPurpose": "Define unitary matrices and explain why quantum operations preserve probability.",
      "transitionOut": "smooth_crossfade"
