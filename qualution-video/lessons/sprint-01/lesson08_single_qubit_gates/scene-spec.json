    {
      "id": "scene-06",
      "title": "Self-Inverse and Cancellation Rules",
      "durationSeconds": 30,
      "startFrame": 4351,
      "endFrame": 5250,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Many quantum gates are self-inverse: applying X twice returns the state to identity: X \u00b7 X = I. The same holds for Hadamard: H \u00b7 H = I. In QUALUTION's circuit optimizer, adjacent identical gates are automatically cancelled!",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Self-inverse gates: X\u00b2 = I, Y\u00b2 = I, Z\u00b2 = I, and H\u00b2 = I.",
          "startFrame": 4351,
          "endFrame": 4770
        },
        {
          "text": "QUALUTION's optimizer detects and cancels redundant self-inverse gates automatically.",
          "startFrame": 4771,
          "endFrame": 5250
        }
      ],
      "onScreenText": [
        {
          "id": "txt_canc",
          "text": "Self-Inverse Cancellation Rules",
          "role": "header",
          "position": [
            0.0,
            2.0,
            0.1
          ]
        },
        {
          "id": "txt_rules",
          "text": "X \u00b7 X = I   |   H \u00b7 H = I   |   Z \u00b7 Z = I",
          "role": "formula",
          "position": [
            0.0,
            0.0,
            0.1
          ]
        }
      ],
