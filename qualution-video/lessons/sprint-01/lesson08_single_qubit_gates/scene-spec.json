    {
      "id": "scene-04",
      "title": "Phase Gates: S and T",
      "durationSeconds": 30,
      "startFrame": 2401,
      "endFrame": 3300,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Beyond full 180-degree flips, we need finer phase control. The S gate applies a 90-degree phase shift\u2014it is the square root of Z. The T gate applies a 45-degree phase shift\u2014the fourth root of Z, crucial for universal quantum computation.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "S Gate: applies a 90\u00b0 (\u03c0/2) phase shift. S\u00b2 = Z.",
          "startFrame": 2401,
          "endFrame": 2820
        },
        {
          "text": "T Gate: applies a 45\u00b0 (\u03c0/4) phase shift. T\u00b2 = S, T\u2074 = Z. Crucial for universality!",
          "startFrame": 2821,
          "endFrame": 3300
        }
      ],
      "onScreenText": [
        {
          "id": "txt_sgate",
          "text": "S = [ [1, 0], [0, i] ]",
          "role": "formula",
          "position": [
            -3.5,
            0.5,
            0.1
          ]
        },
        {
          "id": "txt_tgate",
          "text": "T = [ [1, 0], [0, e^(i\u03c0/4)] ]",
          "role": "formula",
          "position": [
            3.5,
            0.5,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_4_bg",
          "type": "background_plate",
          "source": "assets/backgrounds/deep_space_grid.png",
          "layer": "background"
        },
        {
          "id": "vis_4_stage",
          "type": "vector_diagram",
          "source": "procedural_blender_object",
          "layer": "primary"
        }
      ],
      "animationActions": [
        {
          "target": "vis_4_stage",
          "action": "fade_in_and_settle",
          "startFrame": 2401,
          "durationFrames": 30
        }
      ],
      "assetsRequired": [
        "deep_space_grid.png",
