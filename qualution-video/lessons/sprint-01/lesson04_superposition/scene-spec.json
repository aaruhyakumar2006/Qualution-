    {
      "id": "scene-01",
      "title": "The Myth vs Reality of Superposition",
      "durationSeconds": 20,
      "startFrame": 1,
      "endFrame": 600,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Popular media often claims that a qubit is 'in two states at the same time.' But mathematically, a qubit in superposition is simply in ONE definite quantum state\u2014a linear combination of basis vectors.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Myth: A qubit is 'magically in two places at once.'",
          "startFrame": 1,
          "endFrame": 270
        },
        {
          "text": "Reality: A qubit is in ONE definite state: a linear combination of basis vectors.",
          "startFrame": 271,
          "endFrame": 600
        }
      ],
      "onScreenText": [
        {
          "id": "txt_head",
          "text": "LESSON 4: UNDERSTANDING SUPERPOSITION",
          "role": "header",
          "position": [
            -6.0,
            3.8,
            0.1
          ]
        },
        {
          "id": "txt_myth",
          "text": "Beyond the Pop-Science Tropes",
          "role": "subheader",
          "position": [
            -6.0,
            3.2,
            0.1
          ]
        }
