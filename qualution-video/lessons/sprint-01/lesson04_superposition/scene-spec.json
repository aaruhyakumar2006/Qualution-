    {
      "id": "scene-07",
      "title": "The Power of Quantum Parallelism",
      "durationSeconds": 35,
      "startFrame": 5101,
      "endFrame": 6150,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Superposition is the engine of quantum advantage. When we place n qubits into superposition, our register simultaneously represents 2 to the power of n basis states\u2014allowing a quantum computer to evaluate entire search spaces in parallel.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Superposition is the engine of quantum advantage.",
          "startFrame": 5101,
          "endFrame": 5550
        },
        {
          "text": "n qubits in superposition encode 2\u207f basis states simultaneously.",
          "startFrame": 5551,
          "endFrame": 6150
        }
      ],
      "onScreenText": [
        {
          "id": "txt_scale",
          "text": "Quantum Parallelism: 2\u207f States",
          "role": "header",
          "position": [
