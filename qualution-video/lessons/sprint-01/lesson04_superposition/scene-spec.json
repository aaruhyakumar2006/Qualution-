    {
      "id": "scene-02",
      "title": "Vector Addition in Hilbert Space",
      "durationSeconds": 25,
      "startFrame": 601,
      "endFrame": 1350,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Think of classical bits as navigating along a single vertical line between 0 and 1. A qubit expands this line into a continuous plane: by adding vectors \u03b1|0\u27e9 and \u03b2|1\u27e9, we point anywhere on the unit circle.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Classical bits exist only at discrete endpoints: 0 or 1.",
          "startFrame": 601,
          "endFrame": 930
        },
        {
          "text": "Quantum superposition is vector addition: \u03b1|0\u27e9 + \u03b2|1\u27e9.",
          "startFrame": 931,
          "endFrame": 1350
        }
      ],
      "onScreenText": [
        {
          "id": "txt_vec",
          "text": "|\u03c8\u27e9 = \u03b1|0\u27e9 + \u03b2|1\u27e9",
          "role": "formula",
          "position": [
            0.0,
            1.5,
            0.1
          ]
        },
        {
          "id": "txt_diag",
          "text": "Vector Superposition in 2D Complex Plane",
          "role": "subheader",
          "position": [
            0.0,
            -1.0,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
