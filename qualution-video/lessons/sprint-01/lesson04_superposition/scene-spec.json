    {
      "id": "scene-06",
      "title": "Superposition on the Bloch Sphere",
      "durationSeconds": 35,
      "startFrame": 4051,
      "endFrame": 5100,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "On the Bloch sphere, the Hadamard gate rotates the state vector 90 degrees from the North Pole down to the equator along the positive X-axis for |+\u27e9, and the negative X-axis for |-\u27e9.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Hadamard rotates the state from the Z-pole to the equatorial plane.",
          "startFrame": 4051,
          "endFrame": 4530
        },
        {
          "text": "|+\u27e9 lies along the +X axis; |-\u27e9 lies along the -X axis.",
          "startFrame": 4531,
          "endFrame": 5100
        }
      ],
      "onScreenText": [
        {
          "id": "txt_bloch_eq",
