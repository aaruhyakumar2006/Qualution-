    {
      "id": "scene-03",
      "title": "Superposition vs Classical Probability",
      "durationSeconds": 30,
      "startFrame": 1351,
      "endFrame": 2250,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "A classical coin spinning in the air has a 50 percent chance of heads, but at every microsecond it is in a definite classical state\u2014you simply lack knowledge. A qubit in superposition is fundamentally indeterminate until measured.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "A flipped coin is classically deterministic with subjective ignorance.",
          "startFrame": 1351,
          "endFrame": 1770
        },
        {
          "text": "A quantum superposition holds intrinsic wave potential and phase.",
          "startFrame": 1771,
          "endFrame": 2250
        }
      ],
      "onScreenText": [
        {
          "id": "txt_comp",
          "text": "Classical Mixture vs Quantum Superposition",
          "role": "header",
          "position": [
            0.0,
            2.5,
            0.1
          ]
        },
        {
          "id": "txt_coin",
          "text": "Coin: Epistemic ignorance (p=0.5)",
          "role": "body",
          "position": [
            -4.0,
            0.0,
            0.1
          ]
        },
        {
          "id": "txt_qstate",
          "text": "Qubit: Coherent wave state with phase",
          "role": "body",
          "position": [
            4.0,
            0.0,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
