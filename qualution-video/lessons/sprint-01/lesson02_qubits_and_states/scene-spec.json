    {
      "id": "scene-05",
      "title": "Complex Probability Amplitudes",
      "durationSeconds": 30,
      "startFrame": 3001,
      "endFrame": 3900,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "The coefficients \u03b1 and \u03b2 are not probabilities themselves\u2014they are complex numbers known as probability amplitudes. Each amplitude contains both a magnitude and an intrinsic quantum phase angle.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Coefficients \u03b1 and \u03b2 are complex probability amplitudes (\u03b1, \u03b2 \u2208 \u2102).",
          "startFrame": 3001,
          "endFrame": 3420
        },
        {
          "text": "Each amplitude possesses both a magnitude and a quantum phase.",
          "startFrame": 3421,
          "endFrame": 3900
        }
      ],
      "onScreenText": [
        {
          "id": "txt_amp",
          "text": "\u03b1, \u03b2 \u2208 \u2102",
          "role": "formula",
          "position": [
            0.0,
            1.5,
            0.1
          ]
        },
        {
          "id": "txt_polar",
          "text": "\u03b1 = r\u2080 e^(i\u03b8\u2080),  \u03b2 = r\u2081 e^(i\u03b8\u2081)",
          "role": "formula",
          "position": [
            0.0,
            -0.5,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_5_bg",
          "type": "background_plate",
