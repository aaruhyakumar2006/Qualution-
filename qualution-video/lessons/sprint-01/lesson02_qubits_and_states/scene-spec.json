    {
      "id": "scene-04",
      "title": "The Basis Vectors |0\u27e9 and |1\u27e9",
      "durationSeconds": 25,
      "startFrame": 2251,
      "endFrame": 3000,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "The standard computational basis consists of two orthogonal column vectors: |0\u27e9 represented as [1, 0] transpose, and |1\u27e9 represented as [0, 1] transpose. Any arbitrary state is a linear combination of these two axes.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Computational basis: |0\u27e9 = [1, 0]\u1d40 and |1\u27e9 = [0, 1]\u1d40.",
          "startFrame": 2251,
          "endFrame": 2640
        },
        {
          "text": "Any state is a linear superposition: |\u03c8\u27e9 = \u03b1|0\u27e9 + \u03b2|1\u27e9.",
          "startFrame": 2641,
          "endFrame": 3000
        }
      ],
      "onScreenText": [
        {
          "id": "txt_b0",
          "text": "|0\u27e9 = [ 1, 0 ]\u1d40",
          "role": "formula",
          "position": [
            -3.5,
            0.0,
            0.1
          ]
        },
        {
          "id": "txt_b1",
          "text": "|1\u27e9 = [ 0, 1 ]\u1d40",
          "role": "formula",
          "position": [
            3.5,
            0.0,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_4_bg",
