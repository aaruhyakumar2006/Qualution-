    {
      "id": "scene-06",
      "title": "The Normalization Constraint",
      "durationSeconds": 25,
      "startFrame": 3901,
      "endFrame": 4650,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Because total probability must always equal 100%, quantum states obey the strict normalization constraint: the absolute square of \u03b1 plus the absolute square of \u03b2 must equal exactly one.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Total probability must equal 1: |\u03b1|\u00b2 + |\u03b2|\u00b2 = 1.",
          "startFrame": 3901,
          "endFrame": 4260
        },
        {
          "text": "Measurement guarantees one of the two computational basis outcomes.",
          "startFrame": 4261,
          "endFrame": 4650
        }
      ],
      "onScreenText": [
        {
          "id": "txt_norm",
          "text": "|\u03b1|\u00b2 + |\u03b2|\u00b2 = 1.0",
          "role": "formula",
          "position": [
            0.0,
            0.8,
            0.1
          ]
        },
        {
          "id": "txt_cons",
          "text": "Law of Conservation of Quantum Probability",
          "role": "subheader",
          "position": [
            0.0,
            -1.0,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_6_bg",
          "type": "background_plate",
