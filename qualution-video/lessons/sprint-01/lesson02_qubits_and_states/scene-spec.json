    {
      "id": "scene-03",
      "title": "Dirac Notation & State Vectors",
      "durationSeconds": 30,
      "startFrame": 1351,
      "endFrame": 2250,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "To mathematically capture quantum states, physicist Paul Dirac introduced bra-ket notation. We write the state of our qubit as a ket vector, denoted |\u03c8\u27e9, which lives in a two-dimensional complex Hilbert space.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Physicist Paul Dirac introduced ket notation: |\u03c8\u27e9.",
          "startFrame": 1351,
          "endFrame": 1710
        },
        {
          "text": "A single qubit state lives in a 2-dimensional complex vector space.",
          "startFrame": 1711,
          "endFrame": 2250
        }
      ],
      "onScreenText": [
        {
          "id": "txt_dirac",
          "text": "|\u03c8\u27e9 = \u03b1|0\u27e9 + \u03b2|1\u27e9",
          "role": "formula",
          "position": [
            0.0,
            0.5,
            0.1
          ]
        },
        {
          "id": "txt_hilbert",
          "text": "State Vector in Hilbert Space \u2102\u00b2",
          "role": "subheader",
          "position": [
            0.0,
            -1.5,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_3_bg",
          "type": "background_plate",
          "source": "assets/backgrounds/deep_space_grid.png",
          "layer": "background"
        },
        {
