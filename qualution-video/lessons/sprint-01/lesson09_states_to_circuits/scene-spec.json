    {
      "id": "scene-02",
      "title": "Wire Initialization & Time Flow",
      "durationSeconds": 25,
      "startFrame": 601,
      "endFrame": 1350,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "By convention, every qubit wire begins at time zero in the ground state |0\u27e9. Operations execute sequentially from left to right. When two gates sit in the same vertical column on different wires, they execute simultaneously.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Qubits initialize in |0\u27e9 at the far left.",
          "startFrame": 601,
          "endFrame": 960
        },
        {
          "text": "Time flows left to right. Gates in the same column execute concurrently.",
          "startFrame": 961,
          "endFrame": 1350
        }
      ],
      "onScreenText": [
        {
          "id": "txt_wire_diag",
          "text": "q[0]: |0\u27e9 \u2500\u2500\u2500\u2500\u2500[ H ]\u2500\u2500\u2500\u2500\u2500[ Z ]\u2500\u2500\u2500\u2500\u2500[ M ] \u2500\u2500\u2500> c[0]",
          "role": "formula",
          "position": [
            0.0,
            0.5,
            0.1
          ]
        },
        {
          "id": "txt_time_arrow",
          "text": "TIME PROGRESSION \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500>",
          "role": "subheader",
          "position": [
            0.0,
            -1.0,
            0.1
          ]
        }
      ],
      "visualElements": [
