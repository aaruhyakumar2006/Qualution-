    {
      "id": "scene-04",
      "title": "Circuit Depth and Gate Count",
      "durationSeconds": 35,
      "startFrame": 2251,
      "endFrame": 3300,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "To evaluate circuit efficiency, we measure two key structural metrics: Total Gate Count\u2014the sum of all operations\u2014and Circuit Depth\u2014the number of sequential time steps required to execute the circuit when parallel gates run together.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Total Gate Count: the total number of quantum gates in the circuit.",
          "startFrame": 2251,
          "endFrame": 2730
        },
        {
          "text": "Circuit Depth: the number of concurrent time-steps required to run all gates.",
          "startFrame": 2731,
          "endFrame": 3300
        }
      ],
      "onScreenText": [
        {
          "id": "txt_metrics_title",
          "text": "Circuit Complexity Metrics",
          "role": "header",
          "position": [
            0.0,
            2.5,
            0.1
          ]
        },
        {
          "id": "txt_gc",
          "text": "Total Gate Count = Total number of gates",
          "role": "body",
          "position": [
            0.0,
            0.5,
            0.1
          ]
        },
        {
          "id": "txt_depth",
          "text": "Circuit Depth = Length of critical time path",
          "role": "body",
          "position": [
            0.0,
            -0.5,
            0.1
          ]
        }
      ],
      "visualElements": [
