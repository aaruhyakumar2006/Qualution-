    {
      "id": "scene-03",
      "title": "Matrix Multiplication in Reverse Order",
      "durationSeconds": 30,
      "startFrame": 1351,
      "endFrame": 2250,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "Here is a crucial rule for every quantum programmer: while circuits execute left-to-right, mathematical matrix multiplication is written right-to-left! If a circuit applies gate A then gate B, the overall unitary is B times A.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Visual circuit flow: left to right (Gate A then Gate B).",
          "startFrame": 1351,
          "endFrame": 1770
        },
        {
          "text": "Matrix algebra order: right to left! Overall unitary: U = B \u00b7 A.",
          "startFrame": 1771,
          "endFrame": 2250
        }
      ],
      "onScreenText": [
        {
          "id": "txt_order_title",
          "text": "The Operator Ordering Rule",
          "role": "header",
          "position": [
            0.0,
            2.5,
            0.1
          ]
        },
        {
          "id": "txt_vis",
          "text": "Circuit: \u2500\u2500\u2500[ A ]\u2500\u2500\u2500[ B ]\u2500\u2500\u2500>",
          "role": "body",
          "position": [
            -3.5,
            0.5,
            0.1
          ]
        },
        {
          "id": "txt_mat",
          "text": "Math: |\u03c8_final\u27e9 = (B \u00b7 A) |0\u27e9",
          "role": "body",
          "position": [
            3.5,
            0.5,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
          "id": "vis_3_bg",
          "type": "background_plate",
          "source": "assets/backgrounds/deep_space_grid.png",
          "layer": "background"
        },
        {
          "id": "vis_3_stage",
          "type": "vector_diagram",
          "source": "procedural_blender_object",
          "layer": "primary"
        }
