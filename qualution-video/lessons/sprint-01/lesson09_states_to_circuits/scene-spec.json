    {
      "id": "scene-05",
      "title": "Measurement and Classical Registers",
      "durationSeconds": 30,
      "startFrame": 3301,
      "endFrame": 4200,
      "narration": {
        "speaker": "QUALUTION Narrator",
        "text": "At the end of a circuit, measurement meters convert quantum statevectors into classical bits, storing the results in a classical register denoted with double lines. This marks the transition from quantum coherence to classical data.",
        "tone": "Authoritative, pedagogically clear, engaging",
        "pacingWpm": 130
      },
      "captions": [
        {
          "text": "Measurement meters convert quantum information into classical bits.",
          "startFrame": 3301,
          "endFrame": 3720
        },
        {
          "text": "Classical registers are indicated by double lines (c[0], c[1]).",
          "startFrame": 3721,
          "endFrame": 4200
        }
      ],
      "onScreenText": [
        {
          "id": "txt_meter",
          "text": "q[0] \u2500\u2500\u2500[ M ]\u2500\u2500\u2500\n          \u2551\n          \u25bc\nc[0] \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 (Classical Bit Storage)",
          "role": "formula",
          "position": [
            0.0,
            0.2,
            0.1
          ]
        }
      ],
      "visualElements": [
        {
